<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dfd_documents.DocumentFolderKanbanView" t-inherit="web.KanbanView" t-inherit-mode="primary">
        <!-- .o_content (de web.Layout) es el padre directo real de este slot: se convierte en
             contenedor flex de 2 columnas por CSS (ver o_dfd_folder_kanban_layout en el scss).
             DocumentFolderTreeSidebar y DocumentFolderBreadcrumb quedan como hermanos directos
             del Renderer dentro de ese mismo .o_content, sin reestructurar el DOM nativo. -->
        <xpath expr="//t[@t-component='props.Renderer']" position="before">
            <DocumentFolderTreeSidebar activeFolderId="props.context.active_folder_id"/>
            <DocumentFolderBreadcrumb activeFolderId="props.context.active_folder_id"/>
        </xpath>
    </t>

    <t t-name="dfd_documents.DocumentFolderBreadcrumb">
        <ol class="dfd_document_breadcrumb breadcrumb mb-0">
            <li class="breadcrumb-item"
                t-att-class="{ o_dfd_folder_drag_over: state.dragOverFolderId === false }"
                t-on-dragover="(ev) => this.onFolderDragOver(ev, false)"
                t-on-dragleave="() => this.onFolderDragLeave()"
                t-on-drop="(ev) => this.onFolderDrop(ev, false)">
                <a href="#" t-on-click.prevent="() => this.goTo(false)">
                    <i class="fa fa-folder-o me-1"/>Documentos
                </a>
            </li>
            <t t-foreach="state.path" t-as="folder" t-key="folder.id">
                <li class="breadcrumb-item"
                    t-att-class="{ o_dfd_folder_drag_over: state.dragOverFolderId === folder.id }"
                    t-on-dragover="(ev) => this.onFolderDragOver(ev, folder.id)"
                    t-on-dragleave="() => this.onFolderDragLeave()"
                    t-on-drop="(ev) => this.onFolderDrop(ev, folder.id)">
                    <a href="#" t-on-click.prevent="() => this.goTo(folder.id)">
                        <t t-esc="folder.name"/>
                    </a>
                </li>
            </t>
        </ol>
    </t>

    <t t-name="dfd_documents.DocumentFolderKanbanRenderer" t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="attributes">
            <attribute name="t-att-class">{ o_dfd_kanban_dragging: fileState.dragging }</attribute>
        </xpath>
        <xpath expr="//t[@t-foreach='getGroupsOrRecords()']" position="after">
            <div class="o_kanban_record d-flex flex-grow-1 flex-md-shrink-1 flex-shrink-0"
                 t-foreach="fileState.files" t-as="file" t-key="file.id"
                 t-att-data-doc-file-id="file.id"
                 t-on-click="() => this.openFile(file.id)">
                <div class="oe_kanban_global_click o_dfd_folder_card">
                    <img t-att-src="file.iconSrc" class="o_dfd_folder_icon" alt="Documento" draggable="false"/>
                    <div class="o_dfd_folder_info">
                        <div class="o_dfd_folder_name">
                            <t t-esc="file.name"/>
                        </div>
                        <div class="o_dfd_folder_count text-muted">
                            <t t-esc="file.sizeLabel"/>
                        </div>
                        <div class="o_dfd_folder_count text-muted">
                            Fecha Subida: <t t-esc="file.dateLabel"/>
                        </div>
                    </div>
                    <i class="fa fa-trash-o o_dfd_delete_icon"
                       title="Eliminar documento"
                       t-on-click="(ev) => this.confirmDeleteFile(ev, file.id)"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="inside">
            <div class="o_dfd_kanban_drop_overlay" t-if="fileState.dragging">
                <i class="fa fa-upload me-2"/>Soltar para subir a esta carpeta
            </div>
        </xpath>
    </t>

</templates>
