<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Sin t-if de visibilidad aquí: la comprobación de permiso (can_manage_folder / isAdmin)
         ya se resuelve en isDisplayed (document_folder_rename_menu.js) ANTES de que CogMenu
         decida montar este componente. Si se repitiera aquí con un t-if, el componente seguiría
         contando como "item presente" para CogMenu (ver hasItems en cog_menu.js) y el botón de
         engranaje aparecería con el desplegable vacío en vez de no aparecer directamente. -->
    <t t-name="dfd_documents.RenameFolderMenuItem">
        <DropdownItem class="'o_dfd_rename_folder_menu'" onSelected.bind="renameFolder">
            <i class="fa fa-fw fa-pencil me-1"/>Renombrar
        </DropdownItem>
    </t>

    <t t-name="dfd_documents.ToggleLockFolderMenuItem">
        <DropdownItem class="'o_dfd_toggle_lock_folder_menu'" onSelected.bind="toggleLock" parentClosingMode="'none'">
            <i t-attf-class="fa fa-fw {{ state.isLocked ? 'fa-unlock' : 'fa-lock' }} me-1"/>
            <t t-esc="state.isLocked ? 'Desbloquear' : 'Bloquear'"/>
        </DropdownItem>
    </t>

    <t t-name="dfd_documents.PermissionsFolderMenuItem">
        <DropdownItem class="'o_dfd_permissions_folder_menu'" onSelected.bind="openPermissions">
            <i class="fa fa-fw fa-users me-1"/>Permisos
        </DropdownItem>
    </t>

    <t t-name="dfd_documents.DeleteFolderMenuItem">
        <DropdownItem class="'o_dfd_delete_folder_menu'" onSelected.bind="deleteFolder" parentClosingMode="'none'">
            <i class="fa fa-fw fa-trash-o me-1"/>Eliminar
        </DropdownItem>
    </t>

</templates>
