<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_file_rename_wizard_form" model="ir.ui.view">
        <field name="name">document.file.rename.wizard.form</field>
        <field name="model">document.file.rename.wizard</field>
        <field name="arch" type="xml">
            <form string="Renombrar documento">
                <group>
                    <field name="name" placeholder="Nombre del documento"/>
                    <field name="file_id" invisible="1"/>
                </group>
                <footer>
                    <button string="Renombrar" type="object" name="action_rename_file" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_document_file_rename_wizard" model="ir.actions.act_window">
        <field name="name">Renombrar documento</field>
        <field name="res_model">document.file.rename.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
