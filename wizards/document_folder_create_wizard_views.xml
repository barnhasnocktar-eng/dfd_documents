<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_folder_create_wizard_form" model="ir.ui.view">
        <field name="name">document.folder.create.wizard.form</field>
        <field name="model">document.folder.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Nueva carpeta">
                <group>
                    <field name="name" placeholder="Nombre de la carpeta"/>
                    <field name="parent_id" invisible="1"/>
                </group>
                <footer>
                    <button string="Crear" type="object" name="action_create_folder" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_document_folder_create_wizard" model="ir.actions.act_window">
        <field name="name">Nueva carpeta</field>
        <field name="res_model">document.folder.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
