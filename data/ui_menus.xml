<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- App raíz: sin acción propia, solo agrupa (igual que "Ventas" no tiene vista y
         entra por defecto en su primer submenú, "Presupuestos"). -->
    <menuitem id="menu_document_folder_root"
              name="Documentos"
              sequence="20"/>

    <!-- Icono de menú raíz igual al de Documentos en dfd_holidays -->
    <record id="menu_document_folder_root" model="ir.ui.menu">
        <field name="use_icon" eval="True"/>
        <field name="icon_class_name">ri-folder-line</field>
    </record>

    <menuitem id="menu_document_folder_explorer"
              name="Explorador de archivos"
              action="action_document_folder"
              parent="menu_document_folder_root"
              sequence="10"/>

    <menuitem id="menu_document_configuration"
              name="Configuración"
              parent="menu_document_folder_root"
              sequence="30"/>

    <menuitem id="menu_employee_default_folder"
              name="Carpetas por defecto de Empleados"
              action="action_employee_default_folder"
              parent="menu_document_configuration"
              sequence="10"/>

    <menuitem id="menu_employee_folder_sync_wizard"
              name="Crear carpetas de empleados"
              action="action_employee_folder_sync_wizard"
              parent="menu_document_configuration"
              sequence="20"/>
</odoo>
