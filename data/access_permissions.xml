<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- Oculta carpeta y contenido a quien no pertenezca a ninguno de sus grupos efectivos
         NI sea el usuario relacionado de alguno de sus empleados efectivos (propios o
         heredados de antepasados, más grupos de sistema, ver document_folder.py).
         global="1": se combina con AND respecto a otras reglas, no con OR entre grupos de usuario,
         porque la restricción debe aplicar a todo el mundo por igual, no solo a un grupo concreto. -->
    <record id="rule_document_folder_group_access" model="ir.rule">
        <field name="name">document.folder: solo grupos/empleados permitidos (propios o heredados)</field>
        <field name="model_id" ref="model_document_folder"/>
        <field name="domain_force">['|', ('effective_group_ids', 'in', user.groups_id.ids), ('effective_employee_ids.user_id', '=', user.id)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_document_file_group_access" model="ir.rule">
        <field name="name">document.file: solo grupos/empleados permitidos de su carpeta</field>
        <field name="model_id" ref="model_document_file"/>
        <field name="domain_force">['|', ('effective_group_ids', 'in', user.groups_id.ids), ('effective_employee_ids.user_id', '=', user.id)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
