<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="ir_cron_clean_document_movement_logs" model="ir.cron">
            <field name="name">Purgar historial de movimientos de documentos</field>
            <field name="model_id" ref="model_document_movement_log"/>
            <field name="state">code</field>
            <field name="code">model.cron_clean_movement_logs()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:00:00')"/>
            <field name="priority">5</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
