<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_default_folder_list" model="ir.ui.view">
        <field name="name">document.employee.default.folder.list</field>
        <field name="model">document.employee.default.folder</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_employee_default_folder" model="ir.actions.act_window">
        <field name="name">Carpetas por defecto de Empleados</field>
        <field name="res_model">document.employee.default.folder</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
